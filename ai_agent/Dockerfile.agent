# ==========================================
# AI AGENT DOCKERFILE - PRODUCTION GRADE
# ==========================================

# 1. Sử dụng base image Python slim để tối ưu kích thước và bảo mật
FROM python:3.11-slim

# 2. Thiết lập biến môi trường chuẩn Production cho Python
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# 3. Tạo một User phi đặc quyền (Non-root user) vì lý do bảo mật
# Không bao giờ chạy ứng dụng bằng quyền root để tránh bị hack leo thang đặc quyền
RUN useradd -m -s /bin/bash ai_user

# 4. Cài đặt các thư viện hệ thống cần thiết (nếu có)
# Thêm build-essential nếu cần biên dịch các thư viện AI đặc thù
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 5. Thiết lập thư mục làm việc
WORKDIR /app

# 6. Copy file requirements trước để tận dụng Docker Cache
# Tránh việc mỗi lần sửa code phải tải lại toàn bộ thư viện
COPY requirements.txt .

# 7. Cài đặt thư viện Python
RUN pip install -r requirements.txt

# 8. Copy toàn bộ mã nguồn vào container
COPY . .

# 9. Chuyển quyền sở hữu thư mục cho ai_user
RUN chown -R ai_user:ai_user /app

# 10. Chuyển sang sử dụng user phi đặc quyền
USER ai_user

# 11. Mở port cho Chainlit (UI)
EXPOSE 8000

# 12. Lệnh khởi chạy ứng dụng mặc định
# Chạy ứng dụng bằng Chainlit, host 0.0.0.0 để expose ra ngoài container
CMD ["chainlit", "run", "app.py", "--host", "0.0.0.0", "--port", "8000", "-w"]