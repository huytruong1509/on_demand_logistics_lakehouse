[0m03:04:12.085148 [debug] [Thread-1 (]: On model.consumer_complaints_transformation.stg__consumer_complaints: /* {"app": "dbt", "dbt_version": "1.8.8", "profile_name": "lakehouse_dbt", "target_name": "dev", "node_id": "model.consumer_complaints_transformation.stg__consumer_complaints"} */

  
    

    create table "lakehouse"."silver"."stg__consumer_complaints"
      
      
    as (
      

WITH source_data AS (
    SELECT 
        complaint_id,
        date_received,
        date_sent_to_company,
        product,
        sub_product,
        issue,
        sub_issue,
        company,
        state,
        zip_code,
        tags,
        submitted_via,
        company_response,
        timely,
        has_narrative,
        complaint_what_happened,
        company_public_response,
        _ingest_time,
        _run_id,
        _source_system
    FROM (select * from "lakehouse"."bronze"."raw_consumer_complaints" where false limit 0)
    
    WHERE complaint_id IS NOT NULL 

    
),

casted_data AS (
    SELECT 
        CAST(complaint_id AS VARCHAR) AS complaint_id,
        CAST(company AS VARCHAR) AS company,
        CAST(product AS VARCHAR) AS product,
        CAST(sub_product AS VARCHAR) AS sub_product,
        CAST(issue AS VARCHAR) AS issue,
        CAST(sub_issue AS VARCHAR) AS sub_issue,
        CAST(state AS VARCHAR) AS state,
        CAST(zip_code AS VARCHAR) AS zip_code,
        CAST(tags AS VARCHAR) AS tags,
        CAST(submitted_via AS VARCHAR) AS submitted_via,
        CAST(complaint_what_happened AS VARCHAR) AS complaint_what_happened,
        CAST(company_public_response AS VARCHAR) AS company_public_response,
        
        -- Nhóm Ngày tháng (Cột DATE và TIMESTAMP) - Đã bỏ TRY_CAST/TRY để fail loudly
        CAST(SUBSTRING(date_received, 1, 10) AS DATE) AS date_received,
        CAST(SUBSTRING(date_sent_to_company, 1, 10) AS DATE) AS date_sent_to_company,
        from_iso8601_timestamp(date_received) AS date_received_at,
        from_iso8601_timestamp(date_sent_to_company) AS date_sent_to_company_at,

        CAST(company_response AS VARCHAR) AS company_response,
        
        -- Xử lý an toàn boolean riêng cho timely
        CASE LOWER(CAST(timely AS VARCHAR))
            WHEN 'yes' THEN TRUE
            WHEN 'no' THEN FALSE
            ELSE FALSE
        END AS is_timely,

        -- Bỏ TRY_CAST, dùng CAST thẳng để báo lỗi nếu dữ liệu không phải boolean hợp lệ
        CAST(has_narrative AS BOOLEAN) AS has_narrative,
        
        CAST(_ingest_time AS TIMESTAMP(6) WITH TIME ZONE) AS _ingest_time, 
        CAST(_run_id AS VARCHAR) AS _run_id,
        CAST(_source_system AS VARCHAR) AS _source_system,
        
        -- Chuẩn hóa tên cột kỹ thuật
        current_timestamp AS _silver_updated_at

    FROM source_data
),

deduplicated AS (
    SELECT 
        *,
        ROW_NUMBER() OVER (
            PARTITION BY complaint_id 
            ORDER BY _ingest_time DESC
        ) as row_num
    FROM casted_data
)

SELECT 
    complaint_id,
    company,
    product,
    sub_product,
    issue,
    sub_issue,
    state,
    zip_code,
    tags,
    submitted_via,
    complaint_what_happened,
    company_public_response,
    date_received,
    date_received_at,
    date_sent_to_company,
    date_sent_to_company_at,
    company_response,
    is_timely,
    has_narrative,
    _ingest_time,
    _run_id,
    _source_system,
    _silver_updated_at
FROM deduplicated
WHERE row_num = 1
    )
